#!/usr/bin/env bash
# Fake apt-get: logs its argv, then simulates success/failure based on
# env-controlled patterns so tests can exercise install.sh's error paths.
#   APT_FAIL_ALL=1            -> every invocation fails
#   APT_FAIL_PATTERNS=a,b,c   -> fails if any arg contains one of these substrings
echo "apt-get $*" >> "$CALL_LOG"

if [[ "${APT_FAIL_ALL:-0}" == "1" ]]; then
    echo "fake apt-get: simulated failure (APT_FAIL_ALL)" >&2
    exit 1
fi

if [[ -n "${APT_FAIL_PATTERNS:-}" ]]; then
    IFS=',' read -ra pats <<< "$APT_FAIL_PATTERNS"
    for pat in "${pats[@]}"; do
        for a in "$@"; do
            if [[ "$a" == *"$pat"* ]]; then
                echo "fake apt-get: simulated failure for '$a'" >&2
                exit 1
            fi
        done
    done
fi

exit 0
