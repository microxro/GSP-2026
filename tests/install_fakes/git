#!/usr/bin/env bash
# Fake git for the driver clone/branch-check/checkout sequence install.sh runs.
# No network access is used or required.
#   FAKE_GIT_BRANCHES=v6.6,v6.1,v5.15   branches that "exist" on the remote
echo "git $*" >> "$CALL_LOG"

case "$1" in
    clone)
        dest="${@: -1}"
        mkdir -p "$dest"
        # Drop a fake driver installer into the "clone" so install.sh's
        # `./install.sh` has something real to execute.
        cat > "${dest}/install.sh" <<EOS
#!/usr/bin/env bash
echo "driver-install.sh \$*" >> "${CALL_LOG}"
exit 0
EOS
        chmod 755 "${dest}/install.sh"
        exit 0
        ;;
    ls-remote)
        branch="${@: -1}"
        IFS=',' read -ra branches <<< "${FAKE_GIT_BRANCHES:-}"
        for b in "${branches[@]}"; do
            if [[ "$b" == "$branch" ]]; then
                exit 0
            fi
        done
        exit 2
        ;;
    checkout)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
