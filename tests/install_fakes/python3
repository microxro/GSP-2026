#!/usr/bin/env bash
# Fake python3: used only when the test invokes the installed wrapper
# afterwards, to prove argv (including args containing spaces) survives
# the wrapper's `exec python3 ... "$@"` unchanged, and that the wrapper's
# `export GSP_RECORDINGS_DIR=...` is actually visible to the child process.
echo "python3 $*" >> "$CALL_LOG"
echo "ENV:GSP_RECORDINGS_DIR=[${GSP_RECORDINGS_DIR:-}]"
for a in "$@"; do
    echo "ARG:[$a]"
done
exit 0
